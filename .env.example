DATABASE_URL=postgresql://postgres:postgres@localhost:5432/claimflow_ai?sslmode=disable

# Used to sign secure authentication cookies. Generate a long random value in production.
AUTH_SECRET=replace-with-at-least-32-random-characters

# Server-only model configuration. Never prefix secrets with NEXT_PUBLIC_.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Local deterministic extraction/evaluation controls.
USE_MOCK_EXTRACTION=false
MOCK_DATASET_ROOT=sample-data/week-02-review-failures/packets

# Production demo seed. Enable for the first deploy or intentional refresh.
SEED_DEMO_DATA=false
