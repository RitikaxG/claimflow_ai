{
  "name": "claimflow-ai",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "check-types": "turbo run check-types",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "db:generate": "bun --filter @repo/db db:generate",
    "db:migrate": "bun --filter @repo/db db:migrate",
    "db:studio": "bun --filter @repo/db db:studio",
    "eval:week1:export": "bun --filter @repo/evals export:week1",
    "eval:week1": "bun --filter @repo/evals eval:week1",
    "eval:week2:review": "bun --filter @repo/evals eval:week2:review",
    "rag:load-policies": "bun --filter @repo/rag load-policies"
  },
  "devDependencies": {
    "prettier": "^3.6.0",
    "prettier-plugin-tailwindcss": "^0.7.1",
    "turbo": "^2.9.7"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "bun@1.3.2",
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
