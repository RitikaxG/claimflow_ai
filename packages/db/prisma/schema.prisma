// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum DocumentSourceType {
  PDF
  EMAIL_TEXT
  IMAGE
}

enum ExtractionRunStatus {
  UPLOADED
  EXTRACTING
  VALIDATING
  COMPLETED
  NEEDS_REVIEW
  FAILED
}

enum ReviewTaskStatus {
  PENDING
  IN_REVIEW
  APPROVED
  EDITED_AND_APPROVED
  REJECTED
  NEEDS_MORE_INFO
}

enum ReviewPriority {
  LOW
  NORMAL
  HIGH
}

enum ReviewDecisionType {
  APPROVE_AS_IS
  EDIT_AND_APPROVE
  REJECT
  REQUEST_MORE_INFO
}

enum ReviewEventType {
  REVIEW_TASK_CREATED
  REVIEW_STARTED
  REVIEW_APPROVED_AS_IS
  REVIEW_EDITED_AND_APPROVED
  REVIEW_REJECTED
  REVIEW_MORE_INFO_REQUESTED
}

enum ExtractionEventType {
  DOCUMENT_UPLOADED
  DOCUMENT_SOFT_DELETED
  DOCUMENT_RESTORED
  DUPLICATE_UPLOAD_DETECTED
  EXTRACTION_STARTED
  MODEL_RESPONSE_RECEIVED
  EXTRACTION_COMPLETED
  VALIDATION_STARTED
  VALIDATION_COMPLETED
  MISSING_FIELDS_DETECTED
  CONFLICTS_DETECTED
  RUN_COMPLETED
  RUN_NEEDS_REVIEW
  RUN_FAILED

  AGENT_STEP_STARTED
  AGENT_ACTION_PROPOSED
  AGENT_ACTION_BLOCKED
  AGENT_TOOL_EXECUTED
  FOLLOWUP_DRAFT_CREATED
  ADDITIONAL_EVIDENCE_RECEIVED
  ADDITIONAL_INFORMATION_RECEIVED
  REVIEW_REOPENED
  MEMORY_RETRIEVED
  MEMORY_FEEDBACK_RECORDED
}

enum PolicySourceType {
  SYNTHETIC_MARKDOWN
  PUBLIC_PDF
  PUBLIC_WEB
  TEXT
}

enum CoverageDecision {
  COVERED
  NOT_COVERED
  PARTIALLY_COVERED
  NEEDS_REVIEW
}

enum RetrievalStatus {
  ENOUGH_EVIDENCE
  INSUFFICIENT_EVIDENCE
}

enum AgentActionType {
  RETRIEVE_POLICY_CLAUSES
  CREATE_REVIEW_TASK
  REQUEST_MISSING_DOCUMENT
  MARK_NEEDS_MORE_EVIDENCE
  MARK_NEEDS_MORE_INFO
  DRAFT_FOLLOWUP_REQUEST
  DRAFT_INFORMATION_REQUEST
  DRAFT_APPROVAL_NOTE
  DRAFT_DENIAL_REASON
  ESCALATE_TO_HUMAN
  ASK_CLARIFICATION
  NO_ACTION
}

enum AgentActionStatus {
  PROPOSED
  EXECUTED
  BLOCKED
  FAILED
}

enum GuardrailDecision {
  ALLOWED
  BLOCKED
}

enum FollowupRequestType {
  EVIDENCE_REQUEST
  FIELD_CLARIFICATION
  MIXED_INFO_REQUEST
}

enum WorkflowMemoryKind {
  HUMAN_CORRECTION
  PRIOR_REJECTION
  PRIOR_REVIEW_DECISION
  CLAIMANT_PATTERN
  VENDOR_PATTERN
  POLICY_HISTORY
  RECURRING_ERROR_PATTERN
}

enum WorkflowMemoryStatus {
  ACTIVE
  STRENGTHENED
  WEAKENED
  SUPERSEDED
  RETIRED
}

enum WorkflowMemoryRiskLevel {
  LOW
  MEDIUM
  HIGH
}

enum MemoryUpdateType {
  CREATED
  STRENGTHENED
  WEAKENED
  SUPERSEDED
  RETIRED
  FEEDBACK_RECORDED
  GENERALIZED
}

enum AiCallKind {
  EXTRACTION
  VALIDATION_ASSIST
  RAG_QUERY_REWRITE
  RAG_ANSWER
  AGENT_PLANNER
  MEMORY_WRITER
  MEMORY_SUMMARIZER
  EVAL_JUDGE
  SYNTHETIC_GATEWAY_TEST
}

enum AiCallStatus  {
  STARTED
  SUCCEEDED
  FAILED
  RETRYABLE
  BLOCKED
}

enum AiGatewayFailureType {
  MODEL_TIMEOUT
  INVALID_JSON_RESPONSE
  PROVIDER_ERROR
  COST_LIMIT_EXCEEDED
  LATENCY_SPIKE
  PROMPT_VERSION_REGRESSION
  EVAL_SCORE_DROPPED
  MISSING_TRACE_ID
  MISSING_MODEL_VERSION
  UNKNOWN
}

model Document {
  id String @id @default(cuid())

  filename String
  mimeType String
  sizeBytes Int

  storagePath String?
  contentText String?
  sourceUrl String?
  sourceType DocumentSourceType

  contentHash String?

  runs ExtractionRun[]

  deletedAt DateTime?
  deletedReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([contentHash])
  @@index([sourceType, contentHash])
  @@index([deletedAt])
  @@map("documents")
}

model ExtractionRun {
  id String @id @default(cuid())

  documentId String
  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  sourceWorkflowMemories WorkflowMemory[] @relation("WorkflowMemorySourceRun")
  memoryHits MemoryHit[]
  memoryUpdates MemoryUpdate[]
  aiCallLogs AiCallLog[]

  status ExtractionRunStatus @default(UPLOADED)

  model String?
  promptVersion String?
  schemaVersion String @default("auto_claim_v1")

  rawModelOutput Json?
  extractedJson Json?
  validationJson Json?
  missingFieldsJson Json?
  confidenceJson Json?

  errorMessage String?

  events ExtractionEvent[]
  reviewTask ReviewTask?
  coverageQuestions CoverageQuestion[]

  agentActionLogs AgentActionLog[]
  followupDrafts FollowupDraft[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([documentId])
  @@index([status])
  @@index([schemaVersion])
  @@map("extraction_runs")
}

model ExtractionEvent {
  id String @id @default(cuid())

  runId String
  run ExtractionRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  type ExtractionEventType
  message String
  metadata Json?

  createdAt DateTime @default(now())

  @@index([runId])
  @@index([type])
  @@map("extraction_events")
}

model ReviewTask {
  id String @id @default(cuid())

  runId String @unique
  run ExtractionRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  status ReviewTaskStatus @default(PENDING)
  priority ReviewPriority @default(NORMAL)

  reasonJson Json

  assignedTo String?
  startedAt DateTime?
  completedAt DateTime?

  decisions ReviewDecision[]
  events ReviewEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([priority])
  @@index([createdAt])
  @@map("review_tasks")
}

model ReviewDecision {
  id String @id @default(cuid())

  taskId String
  task ReviewTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  sourceWorkflowMemories WorkflowMemory[] @relation("WorkflowMemorySourceReviewDecision")
  memoryUpdates MemoryUpdate[]

  decision ReviewDecisionType

  correctedJson Json?
  correctedValidationJson Json?
  notes String?
  reviewerName String?

  createdAt DateTime @default(now())

  @@index([taskId])
  @@index([decision])
  @@map("review_decisions")
}

model ReviewEvent {
  id String @id @default(cuid())

  taskId String
  task ReviewTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  type ReviewEventType
  message String
  metadata Json?

  createdAt DateTime @default(now())

  @@index([taskId])
  @@index([type])
  @@map("review_events")
}

model PolicyDocument {
  id String @id @default(cuid())

  title String
  insurerName String?
  productType String
  version String

  sourcePath String?
  sourceType PolicySourceType @default(SYNTHETIC_MARKDOWN)
  contentHash String?

  chunks PolicyChunk[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productType])
  @@index([version])
  @@index([sourceType])
  @@index([contentHash])
  @@map("policy_documents")
}

model PolicyChunk {
  id String @id @default(cuid())

  policyDocumentId String
  policyDocument PolicyDocument @relation(fields: [policyDocumentId], references: [id], onDelete: Cascade)

  chunkIndex Int
  sectionTitle String?
  clauseId String?
  pageNumber Int?

  text String
  tokenCount Int?

  embedding Unsupported("vector(768)")?

  createdAt DateTime @default(now())

  @@unique([policyDocumentId,chunkIndex])
  @@index([policyDocumentId])
  @@index([clauseId])
  @@map("policy_chunks")
}

model CoverageQuestion {
  id String @id @default(cuid())

  runId String
  run ExtractionRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  question String
  normalizedQuery String?

  retrievalStatus RetrievalStatus?
  retrievalJson Json?
  answerJson Json?

  finalDecision CoverageDecision

  createdAt DateTime @default(now())

  @@index([runId])
  @@index([finalDecision])
  @@index([retrievalStatus])
  @@map("coverage_questions")
}

model AgentActionLog {
  id String @id @default(cuid())

  runId String
  run ExtractionRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  memoryHits MemoryHit[]

  action AgentActionType
  status AgentActionStatus

  rationale String?
  // nullable intentionally. If an action is only PROPOSED, guardrails have not decided yet,
  // so forcing ALLOWED or BLOCKED would make the log inaccurate.
  guardrailDecision GuardrailDecision?
  blockedReason String?

  toolName String?
  toolInputJson Json?
  toolOutputJson Json?

  createdAt DateTime @default(now())

  @@index([runId])
  @@index([action])
  @@index([status])
  @@map("agent_action_logs")
}

model FollowupDraft {
  id String @id @default(cuid())

  runId String
  run ExtractionRun @relation(fields: [runId],references: [id],onDelete: Cascade)

  requestType FollowupRequestType @default(EVIDENCE_REQUEST)

  subject String
  body String
  
  requestedEvidence Json
  requestedFields Json @default("[]")
  fieldRequests Json @default("[]")

  status String @default("DRAFTED")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([runId])
  @@index([requestType])
  @@map("followup_drafts")
}

model WorkflowMemory {
  id String @id @default(cuid())

  kind WorkflowMemoryKind
  status WorkflowMemoryStatus @default(ACTIVE)

  riskLevel WorkflowMemoryRiskLevel @default(LOW)
  confidence Float @default(0.6)

  summary String
  safeUse String
  mustNotDo Json @default("[]")

  entityType String?
  entityId String?

  fieldPath String?
  tags Json @default("[]")
  evidenceJson Json?

  sourceRunId String?
  sourceRun ExtractionRun? @relation("WorkflowMemorySourceRun",fields: [sourceRunId], references: [id], onDelete: SetNull)

  sourceReviewDecisionId String?
  sourceReviewDecision ReviewDecision? @relation("WorkflowMemorySourceReviewDecision", fields: [sourceReviewDecisionId], references: [id], onDelete: SetNull)
  
  sourceCoverageQuestionId String?
  sourceAgentActionLogId String?

  confirmedCount Int @default(0)
  contradictedCount Int @default(0)

  supersededByMemoryId String?
  supersededByMemory WorkflowMemory? @relation("MemorySupersession", fields: [supersededByMemoryId], references: [id], onDelete: SetNull)
  supersedes WorkflowMemory[] @relation("MemorySupersession")

  hits MemoryHit[]
  updates MemoryUpdate[]

  lastUsedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([kind])
  @@index([status])
  @@index([riskLevel])
  @@index([entityType, entityId])
  @@index([fieldPath])
  @@index([sourceRunId])
  @@index([sourceReviewDecisionId])
  @@index([status, kind])
  @@index([status, entityType, entityId])
  @@map("workflow_memories")
}

model MemoryHit {
  id String @id @default(cuid())

  memoryId String
  memory WorkflowMemory @relation(fields: [memoryId], references: [id], onDelete: Cascade)

  runId String
  run ExtractionRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  score Int
  matchedOn Json @default("[]")
  retrievalReason String?

  usedByAgent Boolean @default(false)

  agentActionLogId String?
  agentActionLog AgentActionLog? @relation(fields: [agentActionLogId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([memoryId])
  @@index([runId])
  @@index([score])
  @@index([usedByAgent])
  @@index([agentActionLogId])
  @@map("memory_hits")
}

model MemoryUpdate {
  id String @id @default(cuid())

  memoryId String
  memory WorkflowMemory @relation(fields: [memoryId], references: [id], onDelete: Cascade)

  updateType MemoryUpdateType

  runId String?
  run ExtractionRun? @relation(fields: [runId], references: [id], onDelete: SetNull)

  reviewDecisionId String?
  reviewDecision ReviewDecision? @relation(fields: [reviewDecisionId], references: [id], onDelete: SetNull)

  beforeStatus WorkflowMemoryStatus?
  afterStatus WorkflowMemoryStatus?

  confidenceDelta Float?
  note String?
  metadata Json?

  createdAt DateTime @default(now())

  @@index([memoryId])
  @@index([updateType])
  @@index([runId])
  @@index([reviewDecisionId])
  @@index([createdAt])
  @@map("memory_updates")
}

model AiCallLog {
  id String  @id @default(cuid())
  traceId String

  runId String?
  run ExtractionRun? @relation(fields: [runId], references: [id])

  kind AiCallKind
  status AiCallStatus

  provider String
  model String
  modelVersion String?
  promptVersion String?
  schemaVersion String?

  inputJson Json?
  outputJson Json?
  parsedOutputJson Json?

  errorType AiGatewayFailureType?
  errorMessage String?
  retryable Boolean @default(false)

  latencyMs Int?
  inputTokens Int?
  outputTokens Int?
  totalTokens Int?
  estimatedCostUsd Float?

  metadata Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([traceId])
  @@index([runId])
  @@index([kind])
  @@index([status])
  @@index([errorType])
  @@index([createdAt])
  @@map("ai_call_logs")
}