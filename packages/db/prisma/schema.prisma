// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum DocumentSourceType {
  PDF
  EMAIL_TEXT
  IMAGE
}

enum ExtractionRunStatus {
  UPLOADED
  EXTRACTING
  VALIDATING
  COMPLETED
  NEEDS_REVIEW
  FAILED
}

enum ReviewTaskStatus {
  PENDING
  IN_REVIEW
  APPROVED
  EDITED_AND_APPROVED
  REJECTED
  NEEDS_MORE_INFO
}

enum ReviewPriority {
  LOW
  NORMAL
  HIGH
}

enum ReviewDecisionType {
  APPROVE_AS_IS
  EDIT_AND_APPROVE
  REJECT
  REQUEST_MODE_INFO
}

enum ReviewEventType {
  REVIEW_TASK_CREATED
  REVIEW_STARTED
  REVIEW_APPROVED_AS_IS
  REVIEW_EDITED_AND_APPROVED
  REVIEW_REJECTED
  REVIEW_MORE_INFO_REQUESTED
}

enum ExtractionEventType {
  DOCUMENT_UPLOADED
  DOCUMENT_SOFT_DELETED
  DOCUMENT_RESTORED
  DUPLICATE_UPLOAD_DETECTED
  EXTRACTION_STARTED
  MODEL_RESPONSE_RECEIVED
  EXTRACTION_COMPLETED
  VALIDATION_STARTED
  VALIDATION_COMPLETED
  MISSING_FIELDS_DETECTED
  CONFLICTS_DETECTED
  RUN_COMPLETED
  RUN_NEEDS_REVIEW
  RUN_FAILED
}

model Document {
  id String @id @default(cuid())

  filename String
  mimeType String
  sizeBytes Int

  storagePath String?
  contentText String?
  sourceUrl String?
  sourceType DocumentSourceType

  contentHash String?

  runs ExtractionRun[]

  deletedAt DateTime?
  deletedReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([contentHash])
  @@index([sourceType, contentHash])
  @@index([deletedAt])
  @@map("documents")
}

model ExtractionRun {
  id String @id @default(cuid())

  documentId String
  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  status ExtractionRunStatus @default(UPLOADED)

  model String?
  promptVersion String?
  schemaVersion String @default("auto_claim_v1")

  rawModelOutput Json?
  extractedJson Json?
  validationJson Json?
  missingFieldsJson Json?
  confidenceJson Json?

  errorMessage String?

  events ExtractionEvent[]
  reviewTask ReviewTask?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([documentId])
  @@index([status])
  @@index([schemaVersion])
  @@map("extraction_runs")
}

model ExtractionEvent {
  id String @id @default(cuid())

  runId String
  run ExtractionRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  type ExtractionEventType
  message String
  metadata Json?

  createdAt DateTime @default(now())

  @@index([runId])
  @@index([type])
  @@map("extraction_events")
}

model ReviewTask {
  id String @id @default(cuid())

  runId String @unique
  run ExtractionRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  status ReviewTaskStatus @default(PENDING)
  priority ReviewPriority @default(NORMAL)

  reasonJson Json

  assignedTo String?
  startedAt DateTime?
  completedAt DateTime?

  decisions ReviewDecision[]
  events ReviewEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([priority])
  @@index([createdAt])
  @@map("review_tasks")
}

model ReviewDecision {
  id String @id @default(cuid())

  taskId String
  task ReviewTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  decision ReviewDecisionType

  correctedJson Json?
  notes String?
  reviewerName String?

  createdAt DateTime @default(now())

  @@index([taskId])
  @@index([decision])
  @@map("review_decisions")
}

model ReviewEvent {
  id String @id @default(cuid())

  taskId String
  task ReviewTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  type ReviewEventType
  message String
  metadata Json?

  createdAt DateTime @default(now())

  @@index([taskId])
  @@index([type])
  @@map("review_events")
}